# Express Server Configuration
PORT=5000
JWT_SECRET=your_jwt_secret_key_here
CLIENT_URL=http://localhost:5173

# ─── MongoDB Configuration ────────────────────────────────────────────────────
# Option A: MongoDB Atlas (Cloud)
# MONGO_URI=mongodb+srv://<username>:<password>@cluster0.xxxxx.mongodb.net/certiflow?retryWrites=true&w=majority

# Option B: Local MongoDB (default)
MONGO_URI=mongodb://localhost:27017/certiflow

# ─── Email Notification Configuration (Optional - SMTP / Ethereal / Gmail) ────
SMTP_HOST=smtp.ethereal.email
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your_smtp_user@ethereal.email
SMTP_PASS=your_smtp_password
SMTP_FROM_NAME="CertiFlow Academic Portal"
